# Application settings for cinc-dashboard (the chart's ConfigMap).
# Copy to cinc-dashboard.env and edit. NO secrets here: the webui key, the
# session secret and the LDAP bind password live in ./secrets/ and are
# mounted as files (see compose.yaml).
#
# Validation at boot is strict: comment out a variable you don't need, never
# leave it empty. For example "CINC_AUTH_ACTOR=" makes login sign as an empty
# user, and "SESSION_COOKIE_SECURE=" stops the app from starting.

# Root URL of the Cinc server (scheme required). No /organizations/<org>
# path, unlike a client's chef_server_url.
CINC_SERVER_URL=https://cinc.example.com

# Globally-privileged actor that signs POST /authenticate_user (the chart's
# default). Most servers need it: an org-level admin lacks the global create
# permission on that endpoint.
CINC_AUTH_ACTOR=pivotal

# Session lifetime in seconds (8h)
SESSION_TTL_SECONDS=28800

# X-Chef-Version header sent to the server
CHEF_VERSION=16.0.0

# Never true outside testing; trust a private CA with CINC_CA_CERT_FILE instead
# (see compose.yaml)
CINC_SSL_NO_VERIFY=false

# Secure flag on the session cookie. Unset follows NODE_ENV (on in production).
# Uncomment ONLY for a deliberate plain-HTTP deployment.
# SESSION_COOKIE_SECURE=false

# How passwords are checked: "local" (the Cinc server's /authenticate_user) or
# "ldap" (bind against a directory). Either way the user must already exist on
# the Cinc server: LDAP never provisions one.
AUTH_MODE=local

# --- AUTH_MODE=ldap only ----------------------------------------------------
# LDAP_URL=ldaps://dc1.example.com:636
# LDAP_BASE_DN=dc=example,dc=com
# Service account for the search phase (password: the ldap_bind_password
# secret). LDAP_BIND_DN and the password go together: set both or neither.
# LDAP_BIND_DN=cn=svc-cinc-dashboard,ou=service-accounts,dc=example,dc=com
# OpenLDAP: (uid={{username}})  -  Active Directory: (sAMAccountName={{username}})
# LDAP_USER_FILTER=(sAMAccountName={{username}})
# LDAP_SEARCH_TIMEOUT_MS=5000
# LDAP_TLS_NO_VERIFY=false

# Postgres connection string for the dashboard's own admin-plane data
# (accounts, registered servers/collectors, role grants, audit log).
# Unrelated to cinc-collector's own database. May embed credentials, so this
# is set directly here rather than as a Compose secret -- keep this file out
# of version control if you fill it in with a real connection string
# (cinc-dashboard.env is already gitignored).
CINC_DASHBOARD_DATABASE_URL=postgres://user:password@localhost:5432/cinc_dashboard
