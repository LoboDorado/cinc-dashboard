# Optional Compose interpolation variables. Copy to .env next to compose.yaml
# to override the defaults. Application settings go in cinc-dashboard.env.

# Host address published for the console. Keep it on loopback when a reverse
# proxy (Caddy below, or your own) terminates TLS in front of it.
CINC_DASHBOARD_BIND=127.0.0.1:3000

# Hostname served by Caddy ("proxy" profile only)
CINC_DASHBOARD_HOST=cinc-dashboard.example.com

# Image to run. Defaults to the published release matching this checkout; set
# it to pin another tag or a digest.
# CINC_DASHBOARD_IMAGE=ghcr.io/cinc-project/cinc-dashboard:0.7.1
